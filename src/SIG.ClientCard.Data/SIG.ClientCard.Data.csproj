<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sqlite.Core deliberately: the SQLitePCLRaw bundle is chosen by the head
         project (bundle_e_sqlcipher in the app for encryption at rest,
         bundle_e_sqlite3 in tests). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Design-time only (dotnet ef): does not flow to consumers, so the app's
         bundle_e_sqlcipher choice is not contradicted. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.*" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SIG.ClientCard.Core\SIG.ClientCard.Core.csproj" />
  </ItemGroup>

</Project>
