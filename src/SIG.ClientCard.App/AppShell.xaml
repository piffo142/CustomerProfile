<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:SIG.ClientCard.App.Views"
       xmlns:vm="clr-namespace:SIG.ClientCard.App.ViewModels"
       x:Class="SIG.ClientCard.App.AppShell"
       x:DataType="vm:SyncStatusViewModel"
       Title="Beautiful You"
       FlyoutBehavior="Flyout"
       FlyoutBackgroundColor="{StaticResource Cream}">

    <FlyoutItem Title="Clients" Icon="tab_clients.png">
        <ShellContent ContentTemplate="{DataTemplate views:ClientsPage}" Route="clients" />
    </FlyoutItem>

    <!-- Pending-op count and last-sync time. Users tolerate delay; they do not
         tolerate uncertainty. -->
    <Shell.FlyoutFooter>
        <VerticalStackLayout Padding="20,12" Spacing="2" BackgroundColor="{StaticResource Cream}">
            <Label Text="{Binding StatusLine}" FontSize="13" TextColor="{StaticResource Ink}" />
            <Label Text="{Binding DetailLine}" FontSize="11" TextColor="{StaticResource InkMuted}" />
            <Label Text="{Binding DeadLetterLine}" FontSize="11" TextColor="{StaticResource Danger}"
                   IsVisible="{Binding HasDeadLetters}" />
        </VerticalStackLayout>
    </Shell.FlyoutFooter>
</Shell>
