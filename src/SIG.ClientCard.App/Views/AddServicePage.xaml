<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SIG.ClientCard.App.ViewModels"
             x:Class="SIG.ClientCard.App.Views.AddServicePage"
             x:DataType="vm:AddServiceViewModel"
             Title="Add service"
             Shell.PresentationMode="ModalAnimated">

    <VerticalStackLayout Padding="16" Spacing="12">

        <Label Text="Date" FontAttributes="Bold" />
        <!-- Defaults to today: the common case is recording the treatment just done. -->
        <DatePicker Date="{Binding PerformedOn}" BackgroundColor="{StaticResource White}" />

        <Label Text="Service" FontAttributes="Bold" />
        <Picker Title="Pick from the menu (optional)"
                ItemsSource="{Binding CatalogItems}"
                ItemDisplayBinding="{Binding Name}"
                SelectedItem="{Binding SelectedCatalogItem}"
                BackgroundColor="{StaticResource White}" />
        <Entry Placeholder="e.g. Full body massage" Text="{Binding ServiceDescription}" />

        <Label Text="Price" FontAttributes="Bold" />
        <Entry Placeholder="0.00" Text="{Binding PriceText}" Keyboard="Numeric" />

        <Button Text="Add photo"
                Style="{StaticResource SecondaryButton}"
                Command="{Binding AddPhotoCommand}" />
        <Label Text="✓ Photo attached"
               TextColor="{StaticResource SageDark}"
               IsVisible="{Binding HasPhoto}" />

        <Label Text="{Binding ValidationError}"
               TextColor="{StaticResource Danger}"
               IsVisible="{Binding ValidationError, Converter={StaticResource IsNotEmpty}}" />

        <Button Text="Save" Command="{Binding SaveCommand}" Margin="0,8,0,0" />
        <Button Text="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" />

    </VerticalStackLayout>
</ContentPage>
