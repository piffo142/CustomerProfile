<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SIG.ClientCard.App.ViewModels"
             xmlns:entities="clr-namespace:SIG.ClientCard.Core.Entities;assembly=SIG.ClientCard.Core"
             x:Class="SIG.ClientCard.App.Views.ClientDetailPage"
             x:DataType="vm:ClientDetailViewModel"
             Title="{Binding Client.DisplayName}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Edit" Command="{Binding EditCommand}" />
    </ContentPage.ToolbarItems>

    <!-- One scroll, no tabs within the page: header card, service history, notes feed. -->
    <ScrollView>
        <VerticalStackLayout Padding="14" Spacing="14">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding Client.DisplayName}" FontSize="24" FontAttributes="Bold" />
                    <Label Text="{Binding Client.Phone}" FontSize="16" />
                    <Label Text="{Binding Client.Email}" FontSize="14" TextColor="{StaticResource InkMuted}" />
                    <Label Text="{Binding Client.Address}" FontSize="14" TextColor="{StaticResource InkMuted}" />
                    <BoxView HeightRequest="1" Color="{StaticResource SageLight}" Margin="0,6" />
                    <Label Text="{Binding AcquisitionText}" FontSize="13" TextColor="{StaticResource InkMuted}" />
                    <Label Text="{Binding PatchTestText}" FontSize="13" TextColor="{StaticResource InkMuted}" />
                    <Label Text="⚠ Medical flag — check notes before treatment"
                           FontSize="13"
                           TextColor="{StaticResource Danger}"
                           IsVisible="{Binding Client.MedicalFlag}" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Service history" FontSize="18" FontAttributes="Bold" VerticalTextAlignment="Center" />
                <Button Grid.Column="1" Text="Add service" Command="{Binding AddServiceCommand}" />
            </Grid>

            <Border Style="{StaticResource Card}" Padding="6">
                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding Services}">
                    <BindableLayout.EmptyView>
                        <Label Text="No services recorded yet"
                               Padding="10"
                               TextColor="{StaticResource InkMuted}" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="entities:ServiceRecord">
                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="10,8">
                                <Label Text="{Binding PerformedOn, StringFormat='{0:dd MMM yy}'}"
                                       WidthRequest="86"
                                       FontSize="13"
                                       TextColor="{StaticResource InkMuted}"
                                       VerticalTextAlignment="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding ServiceDescription}"
                                       FontSize="15"
                                       VerticalTextAlignment="Center" />
                                <Label Grid.Column="2"
                                       Text="{Binding Price, StringFormat='£{0:0.00}'}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource SageDark}"
                                       VerticalTextAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Notes" FontSize="18" FontAttributes="Bold" VerticalTextAlignment="Center" />
                <Button Grid.Column="1" Text="Add note" Command="{Binding AddNoteCommand}" />
            </Grid>

            <!-- Reverse-chronological, append-only. Notes are never edited. -->
            <VerticalStackLayout Spacing="8"
                                 BindableLayout.ItemsSource="{Binding Notes}">
                <BindableLayout.EmptyView>
                    <Label Text="No notes yet"
                           Padding="10"
                           TextColor="{StaticResource InkMuted}" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="entities:ClientNote">
                        <Border Style="{StaticResource Card}" Padding="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding CreatedAt, StringFormat='{0:HH:mm, d MMM yyyy}'}"
                                       FontSize="11"
                                       TextColor="{StaticResource InkMuted}" />
                                <Label Text="{Binding Body}" FontSize="14" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="{StaticResource SageLight}" Margin="0,10,0,0" />

            <Button Text="Delete client" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" />
            <Button Text="Erase permanently (GDPR)" Style="{StaticResource DangerButton}" Command="{Binding EraseCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
