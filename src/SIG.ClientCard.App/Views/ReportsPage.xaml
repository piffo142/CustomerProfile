<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SIG.ClientCard.App.ViewModels"
             xmlns:data="clr-namespace:SIG.ClientCard.Data;assembly=SIG.ClientCard.Data"
             x:Class="SIG.ClientCard.App.Views.ReportsPage"
             x:DataType="vm:ReportsViewModel"
             Title="Reports">

    <ScrollView>
        <VerticalStackLayout Padding="14" Spacing="12">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding ActiveClientsText}" FontSize="18" FontAttributes="Bold" />
                    <Label Text="{Binding RevenueText}" FontSize="15" TextColor="{StaticResource SageDark}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Revenue by month" FontSize="18" FontAttributes="Bold" />
            <Border Style="{StaticResource Card}" Padding="6">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Monthly}">
                    <BindableLayout.EmptyView>
                        <Label Text="No services recorded yet" Padding="10" TextColor="{StaticResource InkMuted}" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="data:MonthlyRevenue">
                            <Grid ColumnDefinitions="*,Auto,Auto" Padding="10,6">
                                <Label Text="{Binding Label}" FontSize="14" />
                                <Label Grid.Column="1"
                                       Text="{Binding Visits, StringFormat='{0} visit(s)'}"
                                       FontSize="13" TextColor="{StaticResource InkMuted}"
                                       Margin="0,0,14,0" />
                                <Label Grid.Column="2"
                                       Text="{Binding Total, StringFormat='£{0:N2}'}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource SageDark}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

            <Label Text="Top services (12 months)" FontSize="18" FontAttributes="Bold" />
            <Border Style="{StaticResource Card}" Padding="6">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding TopServices}">
                    <BindableLayout.EmptyView>
                        <Label Text="No services recorded yet" Padding="10" TextColor="{StaticResource InkMuted}" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="data:ServicePopularity">
                            <Grid ColumnDefinitions="*,Auto,Auto" Padding="10,6">
                                <Label Text="{Binding Name}" FontSize="14" />
                                <Label Grid.Column="1"
                                       Text="{Binding Count, StringFormat='×{0}'}"
                                       FontSize="13" TextColor="{StaticResource InkMuted}"
                                       Margin="0,0,14,0" />
                                <Label Grid.Column="2"
                                       Text="{Binding Revenue, StringFormat='£{0:N2}'}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource SageDark}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
