<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="800" height="600">
  <!-- Beautiful You Aesthetics and Beauty Logo -->
  <defs>
    <style>
      .sage { stroke: #A9BCA4; fill: none; }
      .peach { fill: #F4B8A3; stroke: #F4B8A3; }
      .peach-fill { fill: #F4B8A3; }
      .text-peach { fill: #F4B8A3; }
      .text-grey { fill: #9BA4A0; }
    </style>
  </defs>

  <!-- Woman's Profile -->
  <g class="sage" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
    <!-- Head outline -->
    <path d="M 200 120 Q 180 140 175 170 Q 172 200 180 230 Q 185 250 190 260" />
    <!-- Forehead and face -->
    <path d="M 200 120 Q 230 100 265 105 Q 295 110 310 130" />
    <!-- Nose -->
    <path d="M 180 170 Q 175 180 177 190 Q 178 195 182 198" />
    <!-- Lips -->
    <path d="M 182 210 Q 188 213 193 212 Q 198 211 202 208" stroke-width="2.5" />
    <path d="M 182 215 Q 188 218 193 217 Q 198 216 202 213" stroke-width="2" />
    <!-- Chin to neck -->
    <path d="M 190 260 Q 185 280 190 310 Q 195 340 210 365" />
    <!-- Neck -->
    <path d="M 210 365 Q 220 390 240 410" />

    <!-- Closed eye -->
    <ellipse cx="215" cy="160" rx="12" ry="6" fill="none" stroke-width="2" />
    <path d="M 203 160 Q 215 163 227 160" stroke-width="2" fill="none" />
    <!-- Eyelashes -->
    <path d="M 205 157 L 203 153 M 215 158 L 215 154 M 225 157 L 227 153" stroke-width="1.5" />
    <!-- Eyebrow -->
    <path d="M 200 145 Q 215 142 230 145" stroke-width="2.5" />

    <!-- Ear suggestion -->
    <path d="M 240 170 Q 248 175 250 185 Q 248 195 240 198" stroke-width="2" />

    <!-- Hair - flowing back -->
    <path d="M 200 120 Q 185 115 175 125 Q 168 135 170 150" stroke-width="3" />
    <path d="M 210 110 Q 195 105 183 112 Q 175 118 175 130" stroke-width="2.5" />
    <path d="M 265 105 Q 285 100 305 108 Q 320 115 325 135" stroke-width="3" />
    <path d="M 310 130 Q 325 145 330 170 Q 332 195 325 220" stroke-width="3" />
    <path d="M 325 220 Q 318 250 305 280 Q 295 305 290 330" stroke-width="3" />
    <!-- Additional hair strands -->
    <path d="M 275 108 Q 290 105 300 115 Q 305 125 305 140" stroke-width="2" />
    <path d="M 315 150 Q 320 170 318 190 Q 315 210 308 230" stroke-width="2" />

    <!-- Shoulder -->
    <path d="M 240 410 Q 270 430 310 435 Q 350 438 380 425" stroke-width="3" />
    <path d="M 210 365 Q 180 385 145 395 Q 110 402 80 400" stroke-width="3" />

    <!-- Collarbone detail -->
    <path d="M 200 380 Q 230 395 265 398" stroke-width="2" />
  </g>

  <!-- Flower beside head -->
  <g stroke-linecap="round" stroke-linejoin="round">
    <!-- Stem -->
    <path d="M 360 210 Q 365 250 370 290" class="sage" stroke-width="3" fill="none" />
    <!-- Leaves -->
    <path d="M 365 250 Q 380 255 390 250 Q 395 245 390 240 Q 380 238 365 245" class="sage" stroke-width="2" fill="#C8D5C8" />
    <path d="M 368 270 Q 355 278 348 275 Q 343 270 348 265 Q 358 263 368 268" class="sage" stroke-width="2" fill="#C8D5C8" />

    <!-- Flower petals (lotus/tulip style) -->
    <ellipse cx="345" cy="180" rx="18" ry="28" class="peach" stroke-width="2" transform="rotate(-25 345 180)" opacity="0.85" />
    <ellipse cx="375" cy="180" rx="18" ry="28" class="peach" stroke-width="2" transform="rotate(25 375 180)" opacity="0.85" />
    <ellipse cx="360" cy="165" rx="18" ry="28" class="peach" stroke-width="2" transform="rotate(0 360 165)" opacity="0.9" />
    <ellipse cx="352" cy="195" rx="16" ry="25" class="peach" stroke-width="1.5" transform="rotate(-15 352 195)" opacity="0.75" />
    <ellipse cx="368" cy="195" rx="16" ry="25" class="peach" stroke-width="1.5" transform="rotate(15 368 195)" opacity="0.75" />
  </g>

  <!-- Text: "Beautiful You" -->
  <text x="400" y="380" font-family="'Brush Script MT', 'Lucida Handwriting', cursive" font-size="72" class="text-peach" font-style="italic">Beautiful You</text>

  <!-- Text: "AESTHETICS AND BEAUTY" -->
  <text x="400" y="420" font-family="'Montserrat', 'Arial', sans-serif" font-size="22" letter-spacing="6" class="text-grey" font-weight="300">AESTHETICS AND BEAUTY</text>
</svg>
